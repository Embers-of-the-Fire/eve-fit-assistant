# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
temp/

# JVM crash byproducts (heap dumps can be multi-GB)
*.hprof
core.[0-9]*

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/*

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/
*.code-workspace

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
unlocalized_messages.txt
android/build/reports/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# dev-specific configurations
.env
efa.dev.toml
!ci/config/efa.dev.toml
.efa.cache
cache/

# rust
/target

# python
__pycache__/

# nix
/.direnv
.envrc

# Node.js / pnpm
node_modules/
.pnpm-store/

# Site build outputs
site/.svelte-kit/
site/build/
site/.wrangler/

# Worker build outputs
pkg/*/dist/
pkg/*/.wrangler/

# Python artifact
*.egg-info/

# External build artifact, e.g. AppImage
dist/
appimage-build/

