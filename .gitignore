# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
temp/

# JVM crash byproducts (heap dumps can be multi-GB)
*.hprof
core.[0-9]*

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/*

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/
*.code-workspace

# Flutter/Dart/Pub related (workspace-level)
.dart_tool/
.pub-cache/
.pub/
# Legacy pre-melos app build output (app builds now land in apps/eve-fit-assistant/build/)
/build/

# dev-specific configurations
.env
efa.dev.toml
!ci/config/efa.dev.toml
.efa.cache
cache/

# rust
/target

# python
__pycache__/

# nix
/.direnv
.envrc

# Node.js / pnpm
node_modules/
.pnpm-store/

# Site build outputs
site/.svelte-kit/
site/build/
site/.wrangler/
.svelte-check/

# Worker build outputs
pkg/*/dist/
pkg/*/.wrangler/

# Python artifact
*.egg-info/

# External build artifact, e.g. AppImage
dist/
appimage-build/

