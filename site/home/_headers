# Copied into the build output by adapter-cloudflare, which then appends its
# autogenerated /_app rules. Cloudflare Pages combines the headers of every
# matching rule (a more specific rule does not override a less specific one),
# so without the detach rule below, /_app/* assets would inherit this catch-all
# Cache-Control on top of the adapter's own headers. Edge-cache the prerendered
# HTML briefly with a generous SWR window; without this every HTML request
# revalidates (max-age=0).
/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Detach the catch-all Cache-Control from generated app assets so they are
# governed solely by the adapter's appended rules (no-cache for /_app/*,
# immutable for /_app/immutable/*).
/_app/*
  ! Cache-Control
