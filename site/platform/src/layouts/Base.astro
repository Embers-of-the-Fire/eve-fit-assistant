---
import Footer from "../components/Footer.svelte";
import Topbar from "../components/Topbar.svelte";
import { en, type TranslationKey } from "../lib/translations";
import "../styles/global.css";

interface Props {
    title?: string;
    titleKey?: TranslationKey;
}

const { title, titleKey } = Astro.props;
const resolvedTitle = title ?? (titleKey ? en[titleKey] : "EFA Platform");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{resolvedTitle} · EFA Platform</title>
        {titleKey && <meta name="efa:title-key" content={titleKey} />}
        <slot name="head" />
    </head>
    <body class="flex min-h-screen flex-col">
        <Topbar client:load />
        <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
            <slot />
        </main>
        <Footer client:load />
        <script>
            import { bindDocumentTitle } from "../lib/i18n.svelte";
            import type { TranslationKey } from "../lib/translations";

            const key = document
                .querySelector('meta[name="efa:title-key"]')
                ?.getAttribute("content");
            if (key) bindDocumentTitle(key as TranslationKey);
        </script>
    </body>
</html>
