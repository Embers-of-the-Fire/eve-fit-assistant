---
import { env } from "cloudflare:workers";
import { toJson } from "@bufbuild/protobuf";
import { FitSnapshotSchema } from "efa-proto-ts/fit_snapshot_pb";

import ThreadSection from "../../components/ThreadSection.svelte";
import Base from "../../layouts/Base.astro";
import { getSnapshotByRequestId, localizedName, REQUEST_ID_PATTERN } from "../../lib/d1";

const requestId = Astro.params.id ?? "";

const stored = REQUEST_ID_PATTERN.test(requestId)
    ? await getSnapshotByRequestId(env.FIT_DB, requestId)
    : null;

if (!stored) {
    Astro.response.status = 404;
}

const fitName = stored?.snapshot.header?.fitName || "Untitled fit";
const shipName = stored ? localizedName(stored.snapshot.ship?.type?.names ?? {}) : "";
const snapshotJson = stored
    ? JSON.stringify(toJson(FitSnapshotSchema, stored.snapshot), null, 2)
    : "";
---

<Base title={stored ? fitName : "Not found"}>
    {
        stored ? (
            <>
                <header class="mb-6">
                    <h1 class="text-2xl font-bold text-console-text">{fitName}</h1>
                    <p class="mt-1 text-sm text-console-text-dim">{shipName}</p>
                    <p class="mt-1 font-mono text-xs break-all text-console-text-muted">
                        request: {stored.requestId}
                    </p>
                    <p class="font-mono text-xs break-all text-console-text-muted">
                        fit: {stored.fitHash}
                    </p>
                </header>
                <section class="rounded border border-console-border bg-console-surface p-4">
                    <h2 class="mb-2 text-lg font-semibold text-console-text">
                        Snapshot data
                    </h2>
                    <pre class="max-h-[36rem] overflow-auto rounded bg-console-deep p-3 text-xs text-console-text-dim">
{snapshotJson}
                    </pre>
                </section>
                <ThreadSection client:load requestId={stored.requestId} />
            </>
        ) : (
            <p class="text-console-text-muted">Snapshot not found.</p>
        )
    }
</Base>
