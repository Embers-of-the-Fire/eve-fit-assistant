---
import PostContent from "../../components/PostContent.svelte";
import ThreadSection from "../../components/ThreadSection.svelte";
import Base from "../../layouts/Base.astro";
import { getPostSnapshot, POST_ID_PATTERN } from "../../lib/platform";

const postId = Astro.params.id ?? "";

const stored = POST_ID_PATTERN.test(postId) ? await getPostSnapshot(postId) : null;

if (!stored) {
    Astro.response.status = 404;
    Astro.cache.set(false);
}

const fitName = stored?.snapshot.header?.fitName ?? "";
const titleKey = stored ? (fitName ? undefined : "fits.untitled") : "fit.notFound";
const snapshot = stored
    ? {
          fitName,
          shipNames: stored.snapshot.ship?.type?.names ?? {},
          postId: stored.postId,
          authorId: stored.authorId,
          fitHash: stored.fitHash,
          snapshotJson: stored.snapshotJson,
      }
    : null;
---

<Base title={fitName || undefined} {titleKey}>
    <PostContent client:load {snapshot} />
    {stored && <ThreadSection client:load postId={stored.postId} />}
</Base>
