<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="EVE Fit Assistant"
      Manufacturer="dev.efa_tech"
      Version="$(var.MsiVersion)"
      UpgradeCode="7F3A9C2E-8B4D-4E1F-9A6B-2C5D8E7F1A3B"
      Scope="perUser"
      InstallerVersion="500">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of EVE Fit Assistant is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Minimal" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Embers-of-the-Fire/eve-fit-assistant" />
    <Icon Id="AppIcon" SourceFile="$(var.RepoRoot)\windows\runner\resources\app_icon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs\EFA" />
    </StandardDirectory>

    <ComponentGroup Id="PayloadComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="StartMenuShortcut" Guid="*">
        <RegistryValue
            Root="HKCU"
            Key="Software\EFA"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <Shortcut
            Directory="ProgramMenuFolder"
            Name="EVE Fit Assistant"
            Target="[INSTALLFOLDER]eve_fit_assistant.exe"
            WorkingDirectory="INSTALLFOLDER" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="EVE Fit Assistant" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
