<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- UpgradeCode is derived at build time as UUIDv5(NAMESPACE_URL,
       "https://efa-tech.dev/msi/upgrade-code"); see upgrade_code() in
       bootstrap/release/windows.py. It identifies the product family across
       releases and must never change. -->
  <Package
      Name="!(loc.ProductName)"
      Manufacturer="dev.efa_tech"
      Version="$(var.MsiVersion)"
      UpgradeCode="$(var.UpgradeCode)"
      Scope="perUser"
      InstallerVersion="500">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="!(loc.DowngradeErrorMessage)" />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" />
    <!-- The InstallDir dialog writes the user-selected folder into this
         directory Id; the default stays %LocalAppData%\Programs\eve_fit_assistant
         per the directory definition below. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoRoot)\distro\windows\installer\LICENSE.rtf" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://efa-tech.dev" />
    <Property Id="ARPHELPLINK" Value="https://docs.efa-tech.dev" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Embers-of-the-Fire/eve-fit-assistant" />
    <Property Id="ARPCOMMENTS" Value="!(loc.ProductDescription)" />
    <Icon Id="AppIcon" SourceFile="$(var.AppRoot)\windows\runner\resources\app_icon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs\eve_fit_assistant" />
    </StandardDirectory>

    <ComponentGroup Id="PayloadComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="StartMenuShortcut" Guid="*">
        <RegistryValue
            Root="HKCU"
            Key="Software\dev.efa_tech\eve_fit_assistant"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <Shortcut
            Directory="ProgramMenuFolder"
            Name="!(loc.ShortcutName)"
            Target="[INSTALLFOLDER]eve_fit_assistant.exe"
            WorkingDirectory="INSTALLFOLDER" />
      </Component>
      <Component Id="EfaProtocolRegistration" Guid="*">
        <RegistryKey Root="HKCU" Key="Software\Classes\efa">
          <RegistryValue Type="string" Value="URL:EFA Protocol" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue
                Type="string"
                Value="&quot;[INSTALLFOLDER]eve_fit_assistant.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
          <RegistryValue Type="integer" Name="Registered" Value="1" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="!(loc.ProductName)" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="EfaProtocolRegistration" />
    </Feature>
  </Package>
</Wix>
