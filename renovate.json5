{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Batched, never-automerged dependency bumps. Every batch is one PR per ecosystem against dev and must pass the `CI / Required` check before a human merges it.',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  baseBranchPatterns: [
    'dev',
  ],
  timezone: 'Asia/Shanghai',
  schedule: [
    '* 0-6 2,16 * *',
  ],
  ignorePaths: [
    'packages/eve-fit-os/**',
  ],
  cloneSubmodules: true,
  cloneSubmodulesFilter: [
    'packages/eve-fit-os',
  ],
  automerge: false,
  separateMajorMinor: false,
  dependencyDashboard: true,
  minimumReleaseAge: '3 days',
  prBodyNotes: [
    "This is a batched dependency update opened by Renovate. Merging is manual: the `CI / Required` check (the change-aware matrix instantiated for the touched ecosystem) must pass first. Details on the bot's role: `docs/agents/ci-release.md`.",
  ],
  labels: [
    'T-Dependencies',
  ],
  vulnerabilityAlerts: {
    labels: [
      'T-Dependencies',
    ],
  },
  postUpdateOptions: [
    'pnpmDedupe',
  ],
  nix: {
    enabled: true,
  },
  customManagers: [
    {
      description:
        "Renovate has no uv manager and its built-in pyenv matcher for .python-version only supports the docker datasource (which renders Python as a Docker dependency), so pyenv is disabled and this file is matched here against the python-version datasource instead",
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)\\.python-version$/',
      ],
      matchStrings: [
        '^(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\\s*$',
      ],
      datasourceTemplate: 'python-version',
      depNameTemplate: 'python',
      versioningTemplate: 'python',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'pyenv',
      ],
      enabled: false,
    },
    {
      groupName: 'Nix flake inputs',
      matchManagers: [
        'nix',
      ],
      schedule: [
        '* 0-6 2 * *',
      ],
    },
    {
      groupName: 'Python dependencies (uv)',
      matchManagers: [
        'pep621',
        'pep723',
      ],
    },
    {
      description: 'Keep the .python-version pin in the Python batch',
      groupName: 'Python dependencies (uv)',
      matchDatasources: [
        'python-version',
      ],
    },
    {
      groupName: 'Rust dependencies (cargo)',
      matchManagers: [
        'cargo',
      ],
    },
    {
      description:
        'Pin rig: upstream ships breaking changes on every minor bump (0.42 to 0.43 broke efa-chat, see PR #499), so rig updates are manual',
      matchManagers: [
        'cargo',
      ],
      matchPackageNames: [
        'rig',
      ],
      enabled: false,
    },
    {
      groupName: 'JS dependencies (pnpm)',
      matchManagers: [
        'npm',
      ],
    },
    {
      description:
        'Pin TypeScript 6 repo-wide: svelte-check --tsgo still requires a TS6 + @typescript/native dual install and astro check has no TS7 support at all (needs @astrojs/ts-content-mapper, TS 7.1+); see PR #503',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'typescript',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      description:
        'Block vitest 5 repo-wide until @cloudflare/vitest-plugin supports it (cloudflare/workers-sdk#15618)',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'vitest',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      groupName: 'Dart/Flutter dependencies (pub)',
      matchManagers: [
        'pub',
      ],
    },
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
      labels: [
        'T-Dependencies',
        'T-CI',
      ],
    },
    {
      matchManagers: [
        'gradle',
        'gradle-wrapper',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'git-submodules',
      ],
      enabled: false,
    },
  ],
}
